{
  "name": "divisor-wave-electron",
  "version": "1.0.0",
  "description": "Divisor Wave Plotter — Electron + Next.js",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n \"NEXT,ELECTRON\" -c \"cyan,yellow\" \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "next-dev": "next dev",
    "electron-dev": "wait-on http://localhost:3000 && electron .",
    "build": "next build && next export",
    "start": "electron ."
  },
  "dependencies": {
    "next": "^14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "wait-on": "^7.0.0"
  }
}
